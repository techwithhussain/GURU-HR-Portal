# Database
DATABASE_URL="postgresql://gda_ems:gda_ems_dev@localhost:5432/gda_ems"
DATABASE_URL_TEST="postgresql://gda_ems:gda_ems_test@localhost:5433/gda_ems_test"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_COOKIE_NAME="gda_ems_session"
SESSION_TTL_HOURS="12"
BCRYPT_COST="12"

# Account lockout policy
ACCOUNT_LOCKOUT_MAX_ATTEMPTS="5"
ACCOUNT_LOCKOUT_WINDOW_MINUTES="10"
ACCOUNT_LOCKOUT_DURATION_MINUTES="15"

# Networking / office IP restriction
# Number of trusted reverse-proxy hops in front of the app (Hostinger = 1).
TRUSTED_PROXY_HOPS="1"

# Background jobs
CRON_SECRET="change-me-to-a-long-random-string"

# App
APP_URL="http://localhost:3000"

# Email (SMTP) — optional. Leave unset to log emails to the console in dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GDA EMS <no-reply@gurudigitaladvertising.com>"
