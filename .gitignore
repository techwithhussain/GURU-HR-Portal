# env files (.env.example is a template with no real secrets, safe to commit)
.env
.env.local
.env.*.local
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# claude code local settings
.claude/

# uploaded leave attachments (local disk storage)
/storage/
