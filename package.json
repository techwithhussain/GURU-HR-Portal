    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "ipaddr.js": "^2.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "luxon": "^3.7.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
