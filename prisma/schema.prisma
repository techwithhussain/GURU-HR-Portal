generator client {
  provider = "prisma-client"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Identity / Auth
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                      String     @id @default(cuid())
  employeeCode            String     @unique
  email                   String     @unique
  passwordHash            String
  roleId                  String
  status                  UserStatus @default(ACTIVE)
  mustChangePassword      Boolean    @default(true)
  failedLoginAttempts     Int        @default(0)
  lastFailedLoginAt       DateTime?
  lockedUntil             DateTime?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  role              Role              @relation(fields: [roleId], references: [id])
  employee          Employee?
  sessions          Session[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  correctedRows     Attendance[]      @relation("AttendanceCorrectedBy")
  notifications     Notification[]
  approvedLeaves    Leave[]           @relation("LeaveApprover")
  cancelledLeaves   Leave[]           @relation("LeaveCancelledBy")
  uploadedDocuments EmployeeDocument[]
  announcements     Announcement[]
  inactivityReviews InactivityEvent[] @relation("InactivityReviewedBy")
  salarySlipsCreated SalarySlip[]     @relation("SalarySlipCreatedBy")
  shiftRequestsReviewed ShiftChangeRequest[] @relation("ShiftRequestReviewedBy")
  attendanceCorrectionsReviewed AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewedBy")

  @@map("users")
}

model Session {
  id         String    @id
  userId     String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Department {
  id             String   @id @default(cuid())
  name           String   @unique
  headEmployeeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  headEmployee Employee?     @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees    Employee[]    @relation("EmployeeDepartment")
  designations Designation[]

  @@map("departments")
}

model Designation {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([departmentId, name])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

model Employee {
  id               String         @id @default(cuid())
  userId           String         @unique
  fullName         String
  phone            String?
  address          String?
  departmentId     String?
  designationId    String?
  shiftId          String?
  managerId        String?
  joiningDate      DateTime       @db.Date
  dateOfBirth      DateTime?      @db.Date
  salary           Decimal?       @db.Decimal(12, 2)
  salaryType       String?
  allowances       Decimal?       @db.Decimal(12, 2)
  deductions       Decimal?       @db.Decimal(12, 2)
  emergencyContact String?
  panNumber        String?
  aadhaarNumber    String?
  bankAccount      String?
  bankName         String?
  documents        Json?
  status           EmployeeStatus @default(ACTIVE)
  profileImageUrl  String?
  windowsUsername  String?        @unique  // e.g. "suhail" — agent detects this automatically
  resignedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  department     Department?   @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  designation    Designation?  @relation(fields: [designationId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  manager        Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]    @relation("EmployeeManager")
  headOfDept     Department[]  @relation("DepartmentHead")
  attendance     Attendance[]
  leaves         Leave[]
  leaveBalances  LeaveBalance[]
  documentFiles  EmployeeDocument[]
  tickets           Ticket[]
  overtimeSessions  OvertimeSession[]
  inactivityEvents  InactivityEvent[]
  agentPcSession    AgentPcSession?   // Which PC this employee is currently logged into
  salarySlips       SalarySlip[]
  shiftChangeRequests ShiftChangeRequest[]
  attendanceCorrections AttendanceCorrectionRequest[]

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

enum EmployeeDocumentType {
  AADHAAR
  PAN
  RESUME
  OFFER_LETTER
  EXPERIENCE_LETTER
  OTHER
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  type             EmployeeDocumentType
  fileName         String
  storagePath      String
  uploadedByUserId String?
  createdAt        DateTime             @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedByUserId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// Shifts & Attendance
// ---------------------------------------------------------------------------

model Shift {
  id                  String   @id @default(cuid())
  name                String
  startMinutesOfDay   Int
  endMinutesOfDay     Int
  gracePeriodMin      Int      @default(0)
  halfDayThresholdMin Int
  overtimeRule        Json
  weeklyOff           Json
  breakAllowanceMin   Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employees              Employee[]
  attendance             Attendance[]
  currentShiftRequests   ShiftChangeRequest[] @relation("CurrentShiftRequests")
  requestedShiftRequests ShiftChangeRequest[] @relation("RequestedShiftRequests")

  @@map("shifts")
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
}

model Attendance {
  id                   String           @id @default(cuid())
  employeeId           String
  attendanceDate       DateTime         @db.Date
  shiftId              String
  checkInAt            DateTime?
  checkInIp            String?
  checkInUserAgent     String?
  checkOutAt           DateTime?
  checkOutIp           String?
  checkOutUserAgent    String?
  workingMinutes       Int?
  breakMinutes         Int?
  lateMinutes          Int              @default(0)
  earlyExitMinutes     Int              @default(0)
  overtimeMinutes      Int              @default(0)
  status               AttendanceStatus @default(PRESENT)
  isAutoClosed         Boolean          @default(false)
  flaggedForReview     Boolean          @default(false)
  correctedByUserId    String?
  correctionReason     String?
  correctionBeforeJson Json?
  adminNotes           String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  employee         Employee @relation(fields: [employeeId], references: [id])
  shift            Shift    @relation(fields: [shiftId], references: [id])
  correctedBy      User?    @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  breaks           Break[]
  overtimeSessions OvertimeSession[]
  inactivityEvents InactivityEvent[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([employeeId])
  @@map("attendance")
}

enum OvertimeStatus {
  ACTIVE
  COMPLETED
}

model OvertimeSession {
  id           String         @id @default(cuid())
  employeeId   String
  attendanceId String
  startAt      DateTime
  endAt        DateTime?
  durationMin  Int?
  status       OvertimeStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([employeeId])
  @@index([attendanceId])
  @@map("overtime_sessions")
}

enum BreakType {
  LUNCH
  TEA
  MEETING
  PERSONAL
  WASHROOM
  OTHER
}

model Break {
  id           String    @id @default(cuid())
  attendanceId String
  type         BreakType
  startAt      DateTime
  endAt        DateTime?
  durationMin  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId, endAt])
  // A partial unique index enforcing "at most one open break per attendance"
  // (WHERE "endAt" IS NULL) is added by migration
  // 20260712210146_break_one_open_per_attendance — Prisma's schema syntax has
  // no way to express a filtered/partial unique constraint, so it isn't
  // representable here, but it exists in the database.
  @@map("breaks")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  defaultAllocationDays Decimal? @db.Decimal(5, 1)
  requiresAttachment    Boolean  @default(false)
  color                 String   @default("#f97316")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  leaves   Leave[]
  balances LeaveBalance[]

  @@map("leave_types")
}

enum LeaveStatus {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id                 String      @id @default(cuid())
  employeeId         String
  typeId             String
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  days               Decimal     @db.Decimal(4, 1)
  isHalfDay          Boolean     @default(false)
  reason             String?
  attachmentPath     String?
  attachmentFileName String?
  status             LeaveStatus @default(APPLIED)
  approverId         String?
  decisionReason     String?
  decidedAt          DateTime?
  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id])
  type        LeaveType @relation(fields: [typeId], references: [id])
  approver    User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  cancelledBy User?     @relation("LeaveCancelledBy", fields: [cancelledByUserId], references: [id])

  @@index([employeeId, status])
  @@index([status])
  @@index([typeId])
  @@map("leaves")
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  typeId     String
  allocated  Decimal   @db.Decimal(5, 1)
  used       Decimal   @db.Decimal(5, 1) @default(0)
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  type     LeaveType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, typeId, year])
  @@map("leave_balances")
}

// ---------------------------------------------------------------------------
// Notifications (schema-only stub this slice)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  targetEntity String
  targetId     String?
  ip           String?
  userAgent    String?
  beforeJson   Json?
  afterJson    Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Company settings (singleton)
// ---------------------------------------------------------------------------

model CompanySetting {
  id                          String   @id @default(cuid())
  name                        String   @default("Guru Digital Advertising")
  timezone                    String   @default("Asia/Kolkata")
  officeIps                   Json     @default("[]")
  officeHours                 Json?
  holidayCalendar             Json?
  emailSettings               Json?
  maxConcurrentBreaks         Int      @default(3)
  inactivityThresholdMinutes  Int      @default(20)
  pcAssignments               Json     @default("{}")  // { "PC-HOSTNAME": "employeeId" }
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("company_settings")
}


// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  isPinned  Boolean   @default(false)
  expiresAt DateTime?
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Support Tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  category    String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  adminReply  String?
  resolvedAt  DateTime?
  employeeId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

// ---------------------------------------------------------------------------
// Activity Tracking — Desktop Agent inactivity events
// ---------------------------------------------------------------------------

enum InactivityStatus {
  PENDING   // Admin has not reviewed yet
  IGNORED   // Admin reviewed and ignored
  NOTED     // Admin reviewed and noted
}

model InactivityEvent {
  id           String          @id @default(cuid())
  employeeId   String
  attendanceId String?
  pcName       String?
  inactiveFrom DateTime
  inactiveTo   DateTime?
  durationMin  Int?
  status       InactivityStatus @default(PENDING)
  adminNote    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id])
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  reviewedBy   User?       @relation("InactivityReviewedBy", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("inactivity_events")
}

// ---------------------------------------------------------------------------
// Agent PC Session — tracks which employee is currently logged into which PC
// One row per PC. Created on HR Portal login, deleted on logout.
// This is the single source of truth for employee-PC mapping.
// ---------------------------------------------------------------------------

model AgentPcSession {
  id               String    @id @default(cuid())
  pcName           String    @unique              // Windows hostname — one active session per PC
  employeeId       String    @unique              // One employee per PC at a time
  loggedInAt       DateTime  @default(now())      // When employee logged into HR Portal
  lastHeartbeatAt  DateTime?                      // Last time desktop agent checked in
  agentVersion     String?                        // Agent version for rollout tracking
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([pcName])
  @@index([employeeId])
  @@map("agent_pc_sessions")
}

// ---------------------------------------------------------------------------
// Salary Slips — admin creates, employee views
// ---------------------------------------------------------------------------

model SalarySlip {
  id               String    @id @default(cuid())
  employeeId       String
  month            Int       // 1-12
  year             Int
  basicSalary      Decimal   @db.Decimal(12, 2)
  specialAllowance Decimal   @db.Decimal(12, 2) @default(0)
  nightAllowance   Decimal   @db.Decimal(12, 2) @default(0)
  otherAllowance   Decimal   @db.Decimal(12, 2) @default(0)
  allowances       Decimal   @db.Decimal(12, 2) @default(0)
  bonus            Decimal   @db.Decimal(12, 2) @default(0)
  pfDeduction      Decimal   @db.Decimal(12, 2) @default(0)
  profTaxDeduction Decimal   @db.Decimal(12, 2) @default(0)
  tdsDeduction     Decimal   @db.Decimal(12, 2) @default(0)
  lopDeduction     Decimal   @db.Decimal(12, 2) @default(0)
  otherDeduction   Decimal   @db.Decimal(12, 2) @default(0)
  deductions       Decimal   @db.Decimal(12, 2) @default(0)
  netSalary        Decimal   @db.Decimal(12, 2)
  workingDays      Int?
  presentDays      Int?
  paidLeaveDays    Int?      @default(0)
  lopDays          Int?      @default(0)
  absentDays       Int?
  notes            String?   @db.Text
  snapEmployeeName String?
  snapEmployeeCode String?
  snapDepartment   String?
  snapDesignation  String?
  snapJoiningDate  DateTime? @db.Date
  snapEmploymentType String?
  snapLocation     String?
  snapPanNumber    String?
  snapAadhaarNumber String?
  snapBankAccount  String?
  snapBankName     String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation("SalarySlipCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@map("salary_slips")
}

// ---------------------------------------------------------------------------
// Employee Requests — Shift Change & Attendance Correction
// ---------------------------------------------------------------------------

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ShiftChangeRequest {
  id               String        @id @default(cuid())
  employeeId       String
  currentShiftId   String
  requestedShiftId String
  reason           String        @db.Text
  status           RequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  adminNote        String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  employee         Employee      @relation(fields: [employeeId], references: [id])
  currentShift     Shift         @relation("CurrentShiftRequests", fields: [currentShiftId], references: [id])
  requestedShift   Shift         @relation("RequestedShiftRequests", fields: [requestedShiftId], references: [id])
  reviewedBy       User?         @relation("ShiftRequestReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@map("shift_change_requests")
}

model AttendanceCorrectionRequest {
  id                String        @id @default(cuid())
  employeeId        String
  attendanceDate    DateTime      @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String        @db.Text
  status            RequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  adminNote         String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  employee          Employee      @relation(fields: [employeeId], references: [id])
  reviewedBy        User?         @relation("AttendanceCorrectionReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([attendanceDate])
  @@map("attendance_correction_requests")
}

