generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Identity / Auth
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                      String     @id @default(cuid())
  employeeCode            String     @unique
  email                   String     @unique
  passwordHash            String
  roleId                  String
  status                  UserStatus @default(ACTIVE)
  mustChangePassword      Boolean    @default(true)
  failedLoginAttempts     Int        @default(0)
  lastFailedLoginAt       DateTime?
  lockedUntil             DateTime?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  role           Role            @relation(fields: [roleId], references: [id])
  employee       Employee?
  sessions       Session[]
  auditLogs      AuditLog[]      @relation("AuditActor")
  correctedRows  Attendance[]    @relation("AttendanceCorrectedBy")
  notifications  Notification[]
  approvedLeaves  Leave[]        @relation("LeaveApprover")
  cancelledLeaves Leave[]        @relation("LeaveCancelledBy")
  uploadedDocuments EmployeeDocument[]

  @@map("users")
}

model Session {
  id         String    @id
  userId     String
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Org structure
// ---------------------------------------------------------------------------

model Department {
  id             String   @id @default(cuid())
  name           String   @unique
  headEmployeeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  headEmployee Employee?     @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees    Employee[]    @relation("EmployeeDepartment")
  designations Designation[]

  @@map("departments")
}

model Designation {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([departmentId, name])
  @@map("designations")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

model Employee {
  id               String         @id @default(cuid())
  userId           String         @unique
  fullName         String
  phone            String?
  address          String?
  departmentId     String?
  designationId    String?
  shiftId          String?
  managerId        String?
  joiningDate      DateTime       @db.Date
  salary           Decimal?       @db.Decimal(12, 2)
  salaryType       String?
  allowances       Decimal?       @db.Decimal(12, 2)
  deductions       Decimal?       @db.Decimal(12, 2)
  emergencyContact String?
  documents        Json?
  status           EmployeeStatus @default(ACTIVE)
  profileImageUrl  String?
  resignedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  department     Department?   @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  designation    Designation?  @relation(fields: [designationId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  manager        Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports  Employee[]    @relation("EmployeeManager")
  headOfDept     Department[]  @relation("DepartmentHead")
  attendance     Attendance[]
  leaves         Leave[]
  leaveBalances  LeaveBalance[]
  documentFiles  EmployeeDocument[]

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

enum EmployeeDocumentType {
  AADHAAR
  PAN
  RESUME
  OFFER_LETTER
  EXPERIENCE_LETTER
  OTHER
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  type             EmployeeDocumentType
  fileName         String
  storagePath      String
  uploadedByUserId String?
  createdAt        DateTime             @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id])
  uploadedBy User?    @relation(fields: [uploadedByUserId], references: [id])

  @@index([employeeId])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// Shifts & Attendance
// ---------------------------------------------------------------------------

model Shift {
  id                  String   @id @default(cuid())
  name                String
  startMinutesOfDay   Int
  endMinutesOfDay     Int
  gracePeriodMin      Int      @default(0)
  halfDayThresholdMin Int
  overtimeRule        Json
  weeklyOff           Json
  breakAllowanceMin   Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employees  Employee[]
  attendance Attendance[]

  @@map("shifts")
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
}

model Attendance {
  id                   String           @id @default(cuid())
  employeeId           String
  attendanceDate       DateTime         @db.Date
  shiftId              String
  checkInAt            DateTime?
  checkInIp            String?
  checkInUserAgent     String?
  checkOutAt           DateTime?
  checkOutIp           String?
  checkOutUserAgent    String?
  workingMinutes       Int?
  breakMinutes         Int?
  lateMinutes          Int              @default(0)
  earlyExitMinutes     Int              @default(0)
  overtimeMinutes      Int              @default(0)
  status               AttendanceStatus @default(PRESENT)
  isAutoClosed         Boolean          @default(false)
  flaggedForReview     Boolean          @default(false)
  correctedByUserId    String?
  correctionReason     String?
  correctionBeforeJson Json?
  adminNotes           String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id])
  shift        Shift    @relation(fields: [shiftId], references: [id])
  correctedBy  User?    @relation("AttendanceCorrectedBy", fields: [correctedByUserId], references: [id])
  breaks       Break[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([employeeId])
  @@map("attendance")
}

enum BreakType {
  LUNCH
  TEA
  MEETING
  PERSONAL
  WASHROOM
  OTHER
}

model Break {
  id           String    @id @default(cuid())
  attendanceId String
  type         BreakType
  startAt      DateTime
  endAt        DateTime?
  durationMin  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@index([attendanceId, endAt])
  @@map("breaks")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveType {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  defaultAllocationDays Decimal? @db.Decimal(5, 1)
  requiresAttachment    Boolean  @default(false)
  color                 String   @default("#f97316")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  leaves   Leave[]
  balances LeaveBalance[]

  @@map("leave_types")
}

enum LeaveStatus {
  APPLIED
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id                 String      @id @default(cuid())
  employeeId         String
  typeId             String
  startDate          DateTime    @db.Date
  endDate            DateTime    @db.Date
  days               Decimal     @db.Decimal(4, 1)
  isHalfDay          Boolean     @default(false)
  reason             String?
  attachmentPath     String?
  attachmentFileName String?
  status             LeaveStatus @default(APPLIED)
  approverId         String?
  decisionReason     String?
  decidedAt          DateTime?
  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id])
  type        LeaveType @relation(fields: [typeId], references: [id])
  approver    User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  cancelledBy User?     @relation("LeaveCancelledBy", fields: [cancelledByUserId], references: [id])

  @@index([employeeId, status])
  @@index([status])
  @@index([typeId])
  @@map("leaves")
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  typeId     String
  allocated  Decimal   @db.Decimal(5, 1)
  used       Decimal   @db.Decimal(5, 1) @default(0)
  year       Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  type     LeaveType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, typeId, year])
  @@map("leave_balances")
}

// ---------------------------------------------------------------------------
// Notifications (schema-only stub this slice)
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  targetEntity String
  targetId     String?
  ip           String?
  userAgent    String?
  beforeJson   Json?
  afterJson    Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Company settings (singleton)
// ---------------------------------------------------------------------------

model CompanySetting {
  id              String   @id @default(cuid())
  name            String   @default("Guru Digital Advertising")
  timezone        String   @default("Asia/Kolkata")
  officeIps       Json     @default("[]")
  officeHours     Json?
  holidayCalendar Json?
  emailSettings   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("company_settings")
}
